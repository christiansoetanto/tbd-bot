# Discord Bot Token
BOTTOKEN=

# Environment Toggles
DEVMODE=FALSE
TBDENV=prod
PORT=8080
GOMEMLIMIT=200MiB

# Cloud Function APIs
ROMCAL_API_FUNCTIONS_URL=

# GitHub API Token (if used by the bot)
GITHUBAPITOKEN=

# Firebase Service Account JSON (Keep this entirely on one line if possible, or ensure it's properly escaped in your actual .env)
FIREBASE_CONFIG=

# Grafana Monitoring
GF_SECURITY_ADMIN_PASSWORD=admin

# Where Grafana sends alerts. Create it under Server Settings -> Integrations ->
# Webhooks in Discord and point it at a channel only you can read. A webhook is
# used rather than email because it needs no credentials and does not depend on
# BOTTOKEN, so it still delivers when the bot itself is the thing that is down.
# Treat the URL as a secret: anyone holding it can post to that channel.
GRAFANA_DISCORD_WEBHOOK_URL=

# External dead-man's switch. Grafana, Prometheus and the bot all run on the
# same Mac Mini, so none of them can report that machine losing power, network
# or Colima — the alerter dies with the thing it watches. The bot pings this
# URL every minute while the Discord gateway is alive, and healthchecks.io
# alerts when the pings stop. Create the check at https://healthchecks.io with
# period 1m / grace 5m and point it at the Discord webhook above.
#
# Treat this as a secret too, in the opposite direction from the webhook:
# anyone holding it can ping success and suppress the alert.
HEALTHCHECKS_PING_URL=
